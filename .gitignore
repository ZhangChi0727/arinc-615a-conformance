# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Qoder auto-generated content
.qoder/

# Accidental skill copies (prevent future occurrences)
?USERPROFILE/

# Captures & large binaries (keep samples small if committed)
*.pcap
*.pcapng
captures/*.log
*.zip

# Local secrets / employer-only dumps (never commit)
secrets/
*.lic
# Employer source materials stay local only — do not push to public GitHub
requirement/
# Training decks / large slides (keep tutorials text-based on public GitHub)
tutorial/**/*.pptx
*.pptx

# Thesis build artifacts
thesis/**/*.aux
thesis/**/*.log
thesis/**/*.out
thesis/**/*.toc
thesis/**/*.synctex.gz
thesis/**/*~

# Temp extract / local notes
**/_filelist.txt
**/__tmp__/

# Local research sources retained for analysis but never published
local-references/
