{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["identity","control","inputBindings","implementationSlices","protocolInputDispositions","toolRequirements","recordContracts","moduleContracts","algorithmRefinements","runtimeParameterContracts","acceptanceCases","implementationDependencies","paperTrace","reviewBoundary"],
  "$defs": {
    "id": {"type":"string","minLength":1},
    "idOnly": {"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"$ref":"#/$defs/id"}}},
    "idPurpose": {"type":"object","additionalProperties":false,"required":["id","purpose"],"properties":{"id":{"$ref":"#/$defs/id"},"purpose":{"type":"string","minLength":1}}}
  },
  "properties": {
    "identity":{"type":"object","additionalProperties":false,"required":["artifactId","version"],"properties":{"artifactId":{"const":"CLTAV-DEVELOPMENT-CONTRACTS"},"version":{"const":"1.0"}}},
    "control":{"type":"object","additionalProperties":false,"required":["changeRequest","decisions","baseCommit"],"properties":{"changeRequest":{"const":"CR-2026-016"},"decisions":{"type":"array","minItems":3,"items":{"type":"string"}},"baseCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "inputBindings":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["artifactId","path","purpose","purposeZh","sha256"],"properties":{"artifactId":{"$ref":"#/$defs/id"},"path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+\\.json$"},"purpose":{"type":"string","minLength":1},"purposeZh":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "implementationSlices":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","scope","scopeZh","requirementIds"],"properties":{"id":{"$ref":"#/$defs/id"},"scope":{"type":"string","minLength":1},"scopeZh":{"type":"string","minLength":1},"requirementIds":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^CRS-M1-[0-9]{5}$"}}}}},
    "toolRequirements":{"type":"array","minItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","title","titleZh","ownerModuleId","sourceRelationship","trigger","preconditions","inputRecordIds","action","outputRecordIds","errorUnknown","evidence","traceability","acceptanceCaseId"],"properties":{"id":{"$ref":"#/$defs/id"},"title":{"type":"string","minLength":1},"titleZh":{"type":"string","minLength":1},"ownerModuleId":{"$ref":"#/$defs/id"},"sourceRelationship":{"enum":["PROTOCOL-DERIVED","METHOD-DERIVED","EXPERIMENT-DERIVED","ENGINEERING-DECISION"]},"trigger":{"type":"string","minLength":1},"preconditions":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"inputRecordIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}},"action":{"type":"string","minLength":1},"outputRecordIds":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}},"interfaceIds":{"type":"array","items":{"$ref":"#/$defs/id"}},"errorUnknown":{"type":"string","minLength":1},"evidence":{"type":"string","minLength":1},"traceability":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"acceptanceCaseId":{"$ref":"#/$defs/id"}}}},
    "recordContracts":{"type":"array","minItems":10,"items":{"$ref":"#/$defs/idOnly"}},
    "moduleContracts":{"type":"array","minItems":5,"items":{"$ref":"#/$defs/idOnly"}},
    "algorithmRefinements":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","boundary"],"properties":{"id":{"$ref":"#/$defs/id"},"boundary":{"type":"string","minLength":1}}}},
    "runtimeParameterContracts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","unit"],"properties":{"id":{"$ref":"#/$defs/id"},"unit":{"type":"string","minLength":1}}}},
    "acceptanceCases":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","kind"],"properties":{"id":{"$ref":"#/$defs/id"},"kind":{"const":"SYNTHETIC-NONTRUTH"}}}},
    "implementationDependencies":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","status"],"properties":{"id":{"$ref":"#/$defs/id"},"status":{"type":"string","minLength":1}}}},
    "paperTrace":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","section"],"properties":{"id":{"$ref":"#/$defs/id"},"section":{"type":"string","minLength":1}}}},
    "protocolInputDispositions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["inputRequirementId","disposition","rationale","rationaleZh","firstSliceRequired"],"properties":{"inputRequirementId":{"type":"string","pattern":"^CRS-M1-[0-9]{5}$"},"disposition":{"enum":["FIRST-SLICE-IMPLEMENTATION","OBSERVER-ONLY","DEPENDENCY-BLOCKED","LATER-SERVICE","CONDITIONAL-VARIANT","NOT-TOOL-OBLIGATION"]},"rationale":{"type":"string","minLength":1},"rationaleZh":{"type":"string","minLength":1},"firstSliceRequired":{"type":"boolean"},"moduleId":{"$ref":"#/$defs/id"},"recordId":{"$ref":"#/$defs/id"},"acceptanceCaseId":{"$ref":"#/$defs/id"}}}},
    "reviewBoundary":{"type":"object","additionalProperties":false,"required":["readiness","claims","completionEvidence"],"properties":{"readiness":{"enum":["READINESS-BLOCKED","CANDIDATE","READY"]},"claims":{"const":"SPECIFICATION-ONLY"},"completionEvidence":{"type":"array","items":{"type":"string"}}}}
  }
}
