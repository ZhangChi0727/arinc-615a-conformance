        "S3": {"x": 520, "y": 180, "w": 200, "h": 56, "label": "S3 exclusive kind"},
        "Admit": {"x": 800, "y": 180, "w": 200, "h": 56, "label": "Admit A2-A5"},
        "S4": {"x": 280, "y": 290, "w": 200, "h": 56, "label": "S4 charge once"},
        "S5": {"x": 520, "y": 290, "w": 200, "h": 56, "label": "S5 execute"},
        "S6": {"x": 760, "y": 290, "w": 200, "h": 56, "label": "S6 interpret"},
        "S7": {"x": 40, "y": 420, "w": 240, "h": 56, "label": "S7 unified ERROR"},
