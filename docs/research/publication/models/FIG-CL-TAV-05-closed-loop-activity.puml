@startuml FIG-CL-TAV-05
skinparam shadowing false
title FIG-CL-TAV-05 Closed-loop activity\nSysML 1.6 notation-based views; executable/metamodel conformance is not claimed\npredict before select; exclusive TEST/Prep/Recover/Admit; charge once; unified ERROR

start
:S0 Idle; SessionContext and HistoryHandle; BUDGET xor ROUNDS; retry=0;
repeat
  :S1 IF-RESOURCE-STOP gate;
  if (already A2-A5 or P1-P5?) then (yes)
    stop
  else (no)
    :S2 IF-PRED-OBS predict classes;
    if (PredictionGapError?) then (yes)
      stop
    else (no)
      :S3 IF-SELECT-ADMIT exclusive kind;
      if (kind ADMIT?) then (yes)
        stop
      elseif (kind TEST and S empty?) then (yes)
        :named spec error; never argmin empty S;
        stop
      elseif (kind PREP or RECOVER?) then (yes)
        :keep named Prep/Recover; do not enter TEST minimax;
      else (TEST nonempty)
        :one-step minimax on predicted nonempty classes;
      endif
      :S4 charge once;
      :S5 IF-EXECUTE-RECORD;
      :S6 IF-OBS-INTERPRET unless exec ERROR;
      if (exec ERROR or interpret ERROR?) then (yes)
        :S7 unified ERROR; do not exclude H; unknown effect is not known q;
        if (retry cap reached?) then (yes)
          :Stop-Error; not A5/Stop-Budget;
          stop
        endif
      else (record valid)
        if (Recover?) then (yes)
          :S8 IF-PREP-RECOVER confirmation;
          if (confirmed?) then (yes)
            :S9 IF-HIST-UPDATE HistoryHandle;
          else (unconfirmed)
            :q remains UNKNOWN; identity on HistoryHandle;
          endif
        else (TEST or Prep)
          :S9 IF-HIST-UPDATE HistoryHandle;
        endif
        :S10 P1-P5 via IF-RESOURCE-STOP and IF-EQUIV;
        if (P-stop?) then (yes)
          stop
        endif
      endif
    endif
  endif
repeat while (no stop?) is (continue)
note right
  admissible A then selectable S; Admit A1-A5
  XOR BUDGET(cmin,B) / ROUNDS(Kmax)
  strictly-reducing TEST else Prep else Recover
  Charge cost once; Hk update
  ERROR ErrorHandle unknown-effect
  confirmed not sent; unconfirmed Recover
  P1 P5 Stop-Empty Stop-Singleton Stop-645
  Stop-Equivalent Stop-Budget Stop-Error Stop-NoDistinguisher
end note
stop
@enduml
