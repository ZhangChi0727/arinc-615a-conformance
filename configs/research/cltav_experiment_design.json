  "claimArguments": [
    {
      "claimId": "CL-C1",
      "boundedProposition": "Within the declared finite domain, one interpretation identity is used across prediction, snapshot, interpretation and whole-history update; true-hypothesis retention additionally requires R1-R5.",
      "locators": ["RR-2026-001 §3.9-§3.9.1", "ALG-CLTAV-06", "ALG-CLTAV-07"],
      "assumptions": ["finite declared hypothesis domain", "qualified ownership and pairing", "conservative observation class", "R1-R5", "versioned whole-history handle"],
      "falsifiers": ["same uncertainty reference changes meaning between interfaces", "H is replaced by an observation class", "true in-domain hypothesis is removed under valid evidence", "evidence insufficiency is treated as unconditional FAIL", "domain-external contamination is claimed always detectable"],
      "allowedWording": "specified conditional consistency and true-hypothesis retention under the declared assumptions",
      "forbiddenWording": "universal soundness or completeness under arbitrary loss, drift, duplication or reordering",
      "reviewGate": "independent mathematical review remains open"
    },
    {
      "claimId": "CL-C2",
      "boundedProposition": "Current feasible affordable TEST actions are ranked by one-step worst residual cardinality, then charged cost and stable identifier; Prep and Recover follow their existing coordination rules.",
      "locators": ["RR-2026-001 §3.9-§3.9.1", "ALG-CLTAV-05"],
      "assumptions": ["finite current nonempty survivor set", "valid prediction classes", "exclusive BUDGET or ROUNDS mode", "positive finite action costs", "declared retry cap"],
      "falsifiers": ["prediction gap scored as zero", "A treated as S", "Prep or Recover scored as TEST", "future evidence leaked to another arm", "claim of global multi-step optimality", "benefit reported after excluding abstention or failed attempts"],
      "allowedWording": "implementation follows the one-step ranking; empirical benefit is a separate estimand",
      "forbiddenWording": "first active loop, Bayesian optimum, or global multi-step optimum",
      "reviewGate": "fair four-arm registration and confirmatory comparison remain open"
    }
  ],
