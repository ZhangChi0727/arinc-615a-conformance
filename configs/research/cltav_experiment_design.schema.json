{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","identity","inputBindings","references","claimArguments","arms","scenarios","metrics","dependencies","pendingDecisions","syntheticWalkthroughs","designAdmission","artifactMap"],
  "$defs": {
    "id": {"type":"string","minLength":1},
    "stringArray": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
    "binding": {"type":"object","additionalProperties":false,"required":["path","gitBlobOid","sha256"],"properties":{"path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+"},"gitBlobOid":{"type":"string","pattern":"^[0-9a-f]{40}$"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "cost": {"type":"object","additionalProperties":false,"required":["acquisition","computation","preparation","recovery","retry"],"properties":{"acquisition":{"type":"number","minimum":0},"computation":{"type":"number","minimum":0},"preparation":{"type":"number","minimum":0},"recovery":{"type":"number","minimum":0},"retry":{"type":"number","minimum":0}}}
  },
  "properties": {
    "schemaVersion":{"const":"1.0"},
    "identity":{"type":"object","additionalProperties":false,"required":["artifactId","version","status","changeRequest","decision","baseCommit","authority"],"properties":{"artifactId":{"const":"CLTAV-EXPERIMENT-DESIGN"},"version":{"type":"string"},"status":{"const":"CANDIDATE-DESIGN"},"changeRequest":{"const":"CR-2026-019"},"decision":{"const":"DD-043"},"baseCommit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"authority":{"type":"string","minLength":1}}},
    "inputBindings":{"type":"array","minItems":6,"items":{"$ref":"#/$defs/binding"}},
    "references":{"type":"object","additionalProperties":false,"required":["claims","families","arms","scenarios","acceptanceMatrix","algorithmInterfaces","experimentInterfaces","records"],"properties":{"claims":{"$ref":"#/$defs/stringArray"},"families":{"$ref":"#/$defs/stringArray"},"arms":{"$ref":"#/$defs/stringArray"},"scenarios":{"$ref":"#/$defs/stringArray"},"acceptanceMatrix":{"$ref":"#/$defs/stringArray"},"algorithmInterfaces":{"$ref":"#/$defs/stringArray"},"experimentInterfaces":{"$ref":"#/$defs/stringArray"},"records":{"$ref":"#/$defs/stringArray"}}},
    "claimArguments":{"type":"array","minItems":2,"items":{"type":"object","additionalProperties":false,"required":["claimId","boundedProposition","locators","assumptions","falsifiers","allowedWording","forbiddenWording","reviewGate"],"properties":{"claimId":{"enum":["CL-C1","CL-C2"]},"boundedProposition":{"type":"string"},"locators":{"$ref":"#/$defs/stringArray"},"assumptions":{"$ref":"#/$defs/stringArray"},"falsifiers":{"$ref":"#/$defs/stringArray"},"allowedWording":{"type":"string"},"forbiddenWording":{"type":"string"},"reviewGate":{"type":"string"}}}},
    "arms":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["id","visibleInputs","actions","feedback","costComponents","prohibitedInputs"],"properties":{"id":{"type":"string"},"visibleInputs":{"$ref":"#/$defs/stringArray"},"actions":{"$ref":"#/$defs/stringArray"},"feedback":{"type":"boolean"},"costComponents":{"$ref":"#/$defs/stringArray"},"prohibitedInputs":{"$ref":"#/$defs/stringArray"}}}},
    "scenarios":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","familyIds","serviceScope","faultClass","truthConfirmation","observableOutcome","resetEvidence","acceptanceMatrixRefs","dependencyIds"],"properties":{"id":{"type":"string"},"familyIds":{"$ref":"#/$defs/stringArray"},"serviceScope":{"enum":["UPLOAD","INFORMATION","FIND","DOWNLOAD","AFDX"]},"faultClass":{"type":"string"},"truthConfirmation":{"type":"string"},"observableOutcome":{"type":"string"},"resetEvidence":{"type":"string"},"acceptanceMatrixRefs":{"$ref":"#/$defs/stringArray"},"dependencyIds":{"$ref":"#/$defs/stringArray"}}}},
    "metrics":{"type":"array","minItems":10,"items":{"type":"object","additionalProperties":false,"required":["id","familyIds","population","numerator","denominator","unit","direction","zeroDenominator","primary","requiredFields","output"],"properties":{"id":{"type":"string","pattern":"^MET-[A-Z0-9-]+$"},"familyIds":{"$ref":"#/$defs/stringArray"},"population":{"type":"string"},"numerator":{"type":"string"},"denominator":{"type":"string"},"unit":{"type":"string"},"direction":{"type":"string"},"zeroDenominator":{"const":"N/A"},"primary":{"type":"boolean"},"requiredFields":{"$ref":"#/$defs/stringArray"},"output":{"type":"string"}}}},
    "dependencies":{"type":"array","minItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","consumers","currentReference","neededEvidence","producer","state","closureTest","blockingMilestone","minimumFollowUp"],"properties":{"id":{"type":"string","pattern":"^DEP-[A-Z0-9-]+$"},"consumers":{"$ref":"#/$defs/stringArray"},"currentReference":{"type":"string"},"neededEvidence":{"type":"string"},"producer":{"type":"string"},"state":{"enum":["EXISTING-REFERENCE","PROPOSED-CONTRACT-DELTA","RUNTIME-PENDING","HUMAN-PENDING"]},"closureTest":{"type":"string"},"blockingMilestone":{"type":"string"},"minimumFollowUp":{"type":"string"}}}},
    "pendingDecisions":{"type":"array","minItems":5,"items":{"type":"object","additionalProperties":false,"required":["id","ownerRole","options","recommendation","evidenceNeeded","freezeBy","blocks","status"],"properties":{"id":{"type":"string","pattern":"^DEC-[A-Z0-9-]+$"},"ownerRole":{"type":"string"},"options":{"$ref":"#/$defs/stringArray"},"recommendation":{"type":"string"},"evidenceNeeded":{"type":"string"},"freezeBy":{"type":"string"},"blocks":{"$ref":"#/$defs/stringArray"},"status":{"const":"OPEN"}}}},
    "syntheticWalkthroughs":{"type":"array","minItems":10,"items":{"type":"object","additionalProperties":false,"required":["id","label","scenarioId","attemptId","runId","truthClass","validity","outcome","stopClass","finalHypotheses","denominators","chargedCost"],"properties":{"id":{"type":"string","pattern":"^SYN-[A-Z0-9-]+$"},"label":{"const":"SYNTHETIC-DESIGN-WALKTHROUGH"},"scenarioId":{"type":"string"},"attemptId":{"type":"string"},"runId":{"type":["string","null"]},"truthClass":{"type":"string"},"validity":{"type":"string"},"outcome":{"enum":["PASS","FAIL","ERROR","INCONCLUSIVE","NOT-ANSWERED"]},"stopClass":{"type":["string","null"]},"finalHypotheses":{"$ref":"#/$defs/stringArray"},"denominators":{"$ref":"#/$defs/stringArray"},"chargedCost":{"$ref":"#/$defs/cost"}}}},
    "designAdmission":{"type":"object","additionalProperties":false,"required":["designReviewStatus","confirmatoryRunStatus","blockingDecisionIds","historicalCaptureUse","syntheticFixtureUse"],"properties":{"designReviewStatus":{"const":"CANDIDATE"},"confirmatoryRunStatus":{"const":"BLOCKED"},"blockingDecisionIds":{"$ref":"#/$defs/stringArray"},"historicalCaptureUse":{"const":"EXPLORATORY-OFFLINE-ONLY"},"syntheticFixtureUse":{"const":"DESIGN-ACCOUNTING-ONLY"}}},
    "artifactMap":{"type":"array","minItems":4,"items":{"type":"object","additionalProperties":false,"required":["id","path","role"],"properties":{"id":{"type":"string"},"path":{"type":"string","pattern":"^(?!/)(?!.*\\.\\.).+"},"role":{"type":"string"}}}}
  }
}
