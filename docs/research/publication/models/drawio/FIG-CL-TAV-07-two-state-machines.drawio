        <mxCell id="note-error-guards" value="ErrorHandle order: CAP first; then E-A4/E-A5 or retry&lt;br&gt;E-A4: retry remains AND unknown-effect AND Recover ineligible | E-A5: retry remains AND unknown-effect AND Recover eligible but unaffordable&lt;br&gt;NOT-SENT: confirmed not sent AND retry remains | E-RETRY: retry remains AND unknown-effect AND Recover in S" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#8C8C8C;strokeWidth=1;fontFamily=Helvetica;fontSize=18;fontColor=#333333;align=left;verticalAlign=middle;spacing=8;shadow=0;glass=0;gradientColor=none;" vertex="1" parent="1" semanticKind="note" semanticRole="interpretation-boundary" sourceNote="error-guards">
