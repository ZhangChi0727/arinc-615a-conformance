{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/cltav-615a-scenarios-1.0.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "identity",
    "controlBinding",
    "translationsZh",
    "acceptedInputs",
    "scope",
    "objectContract",
    "sourceRelations",
    "traceabilityMatrix",
    "hypothesisDomain",
    "actionLibrary",
    "timeAndObservation",
    "resourceContract",
    "lifecycle",
    "cases",
    "experimentRelations",
    "limitations",
    "feasibilityWitnesses"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactId": {
      "const": "CLTAV-615A-SCENARIO-PACKAGE"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "controlBinding": {
      "$ref": "#/$defs/controlBinding"
    },
    "translationsZh": {
      "$ref": "#/$defs/translationsZh"
    },
    "acceptedInputs": {
      "type": "array",
      "minItems": 9,
      "items": {
        "$ref": "#/$defs/inputBinding"
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "objectContract": {
      "$ref": "#/$defs/objectContract"
    },
    "sourceRelations": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/sourceRelation"
      }
    },
    "traceabilityMatrix": {
      "type": "array",
      "minItems": 5,
      "items": {
        "$ref": "#/$defs/traceabilityRelation"
      }
    },
    "hypothesisDomain": {
      "$ref": "#/$defs/hypothesisDomain"
    },
    "actionLibrary": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "timeAndObservation": {
      "$ref": "#/$defs/timeAndObservation"
    },
    "resourceContract": {
      "$ref": "#/$defs/resourceContract"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "cases": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "experimentRelations": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/experimentRelation"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "feasibilityWitnesses": {
      "type": "array",
      "minItems": 4,
      "items": {
        "$ref": "#/$defs/witness"
      }
    }
  },
  "$defs": {
    "nonBlank": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "translationsZh": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nonBlank"
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]*$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioFamilyId",
        "version",
        "engineeringPurpose",
        "acceptedAuthorityCommit",
        "changeRequest",
        "decision",
        "runClassification",
        "stageStatus"
      ],
      "properties": {
        "scenarioFamilyId": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/nonBlank"
        },
        "engineeringPurpose": {
          "const": "ENGINEERING-SUBSCENE-ONLY"
        },
        "acceptedAuthorityCommit": {
          "$ref": "#/$defs/sha1"
        },
        "changeRequest": {
          "const": "CR-2026-022"
        },
        "decision": {
          "const": "DD-046"
        },
        "runClassification": {
          "const": "SYNTHETIC-ENGINEERING-VALIDATION"
        },
        "stageStatus": {
          "const": "G0-A-CANDIDATE-PENDING-INDEPENDENT-REVIEW"
        }
      }
    },
    "controlBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlCommit",
        "path",
        "gitBlobOid",
        "rawSha256"
      ],
      "properties": {
        "controlCommit": {
          "$ref": "#/$defs/sha1"
        },
        "path": {
          "const": "docs/control/changes/CR-2026-022.md"
        },
        "gitBlobOid": {
          "$ref": "#/$defs/sha1"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "path",
        "gitBlobOid",
        "rawSha256",
        "role"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "path": {
          "type": "string",
          "pattern": "^[^\\\\/:][^\\\\]*$"
        },
        "gitBlobOid": {
          "$ref": "#/$defs/sha1"
        },
        "rawSha256": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "roles",
        "startBoundary",
        "endBoundary",
        "preparedButNotExecuted",
        "notEvaluatedObligations",
        "relationshipToExperimentScenario"
      ],
      "properties": {
        "operation": {
          "const": "UPLOAD"
        },
        "roles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "startBoundary": {
          "$ref": "#/$defs/nonBlank"
        },
        "endBoundary": {
          "$ref": "#/$defs/nonBlank"
        },
        "preparedButNotExecuted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notEvaluatedObligations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "relationshipToExperimentScenario": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenarioId",
            "relation",
            "reason"
          ],
          "properties": {
            "scenarioId": {
              "$ref": "#/$defs/identifier"
            },
            "relation": {
              "enum": [
                "IMPLEMENTS-SUBSCENE",
                "PREPARES-INTERFACE",
                "NOT-ADMITTED"
              ]
            },
            "reason": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        }
      }
    },
    "objectStateVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceAnchor",
        "initial",
        "owner",
        "invariant",
        "meaningZh"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourceAnchor": {
          "$ref": "#/$defs/nonBlank"
        },
        "initial": {
          "enum": [
            "FALSE",
            "TRUE"
          ]
        },
        "owner": {
          "enum": [
            "DATA-LOADER",
            "TARGET-HARDWARE"
          ]
        },
        "invariant": {
          "$ref": "#/$defs/nonBlank"
        },
        "meaningZh": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "objectGuardTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRelationId",
        "requiresState",
        "normalVisibleOutputId",
        "faultBypassHypothesisId",
        "meaningZh"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourceRelationId": {
          "$ref": "#/$defs/identifier"
        },
        "requiresState": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        },
        "normalVisibleOutputId": {
          "$ref": "#/$defs/identifier"
        },
        "faultBypassHypothesisId": {
          "$ref": "#/$defs/identifier"
        },
        "meaningZh": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "objectEventProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRelationId",
        "eventId",
        "visibility",
        "meaningZh"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sourceRelationId": {
          "$ref": "#/$defs/identifier"
        },
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "visibility": {
          "enum": [
            "APPLICATION",
            "NETWORK-VISIBLE"
          ]
        },
        "meaningZh": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "objectContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "objectKind",
        "peerKind",
        "stateVariables",
        "guardTransitions",
        "publicStimuli",
        "visibleOutputs",
        "semanticPayloadBoundary",
        "privateBoundary",
        "lifecycleBoundary",
        "implementationIdentityPlan"
      ],
      "properties": {
        "stage": {
          "const": "A-CONTRACT-ONLY-NO-OBJECT-IMPLEMENTATION"
        },
        "objectKind": {
          "const": "IN-PROCESS-CONTROLLED-DATA-LOADER-SURROGATE"
        },
        "peerKind": {
          "const": "IN-PROCESS-CONTROLLED-TARGET-HARDWARE-DRIVER"
        },
        "stateVariables": {
          "type": "array",
          "minItems": 5,
          "items": {
            "$ref": "#/$defs/objectStateVariable"
          }
        },
        "guardTransitions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/objectGuardTransition"
          }
        },
        "publicStimuli": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/objectEventProjection"
          }
        },
        "visibleOutputs": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/objectEventProjection"
          }
        },
        "semanticPayloadBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fileRole",
            "semanticOpcodes",
            "payloadRepresentation",
            "notWirePacketImplementation",
            "meaningZh"
          ],
          "properties": {
            "fileRole": {
              "const": "LUR"
            },
            "semanticOpcodes": {
              "type": "array",
              "minItems": 3,
              "items": {
                "enum": [
                  "WRQ",
                  "ACK",
                  "DATA"
                ]
              }
            },
            "payloadRepresentation": {
              "const": "OPAQUE-NO-LUR-BYTE-PAYLOAD-OR-CHECKSUM-EVALUATED"
            },
            "notWirePacketImplementation": {
              "const": true
            },
            "meaningZh": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        },
        "privateBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evaluatorOnly",
            "algorithmForbidden",
            "permittedAlgorithmProjection",
            "meaningZh"
          ],
          "properties": {
            "evaluatorOnly": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "algorithmForbidden": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "permittedAlgorithmProjection": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "meaningZh": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        },
        "lifecycleBoundary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "faultInstallationLifetime",
            "faultRevocationAction",
            "revocationEvidence",
            "meaningZh"
          ],
          "properties": {
            "faultInstallationLifetime": {
              "const": "CURRENT-ENGINEERING-ATTEMPT-UNTIL-FULL-RESET"
            },
            "faultRevocationAction": {
              "const": "FULL-RESET-REVOKES-ALL-NAMED-VARIANTS"
            },
            "revocationEvidence": {
              "const": "RESET-READBACK-FAULT-INSTALLATION-STATE-CLEARED"
            },
            "meaningZh": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        },
        "implementationIdentityPlan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "requiredAtImplementation",
            "notEstablished",
            "meaningZh"
          ],
          "properties": {
            "status": {
              "const": "CONTRACT-ONLY-NO-LOADER-SOURCE-AT-A"
            },
            "requiredAtImplementation": {
              "type": "array",
              "minItems": 3,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            },
            "notEstablished": {
              "$ref": "#/$defs/nonBlank"
            },
            "meaningZh": {
              "$ref": "#/$defs/nonBlank"
            }
          }
        }
      }
    },
    "stateFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "assertions"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/nonBlank"
        },
        "after": {
          "$ref": "#/$defs/nonBlank"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonBlank"
          }
        }
      }
    },
    "sourceRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requirementId",
        "sourceUnitId",
        "sourceLocator",
        "documentPage",
        "pdfPage",
        "transitionId",
        "eventId",
        "eventDirection",
        "actor",
        "receiver",
        "action",
        "objects",
        "semanticOpcodeClass",
        "fileRole",
        "scenarioRationale",
        "scenarioRationaleZh",
        "visibility",
        "scenarioUse",
        "executedByScenario",
        "notWireOpcode",
        "stateFacts"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "requirementId": {
          "type": "string",
          "pattern": "^CRS-M1-[0-9]{5}$"
        },
        "sourceUnitId": {
          "$ref": "#/$defs/nonBlank"
        },
        "sourceLocator": {
          "$ref": "#/$defs/nonBlank"
        },
        "documentPage": {
          "type": "integer",
          "minimum": 1
        },
        "pdfPage": {
          "type": "integer",
          "minimum": 1
        },
        "transitionId": {
          "$ref": "#/$defs/identifier"
        },
        "eventId": {
          "$ref": "#/$defs/identifier"
        },
        "eventDirection": {
          "enum": [
            "APPLICATION-NO-WIRE",
            "TH-TO-DL",
            "DL-TO-TH"
          ]
        },
        "actor": {
          "$ref": "#/$defs/identifier"
        },
        "receiver": {
          "$ref": "#/$defs/identifier"
        },
        "action": {
          "$ref": "#/$defs/identifier"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "semanticOpcodeClass": {
          "$ref": "#/$defs/identifier"
        },
        "fileRole": {
          "$ref": "#/$defs/identifier"
        },
        "scenarioRationale": {
          "$ref": "#/$defs/nonBlank"
        },
        "scenarioRationaleZh": {
          "$ref": "#/$defs/nonBlank"
        },
        "visibility": {
          "enum": [
            "APPLICATION",
            "NETWORK-VISIBLE"
          ]
        },
        "scenarioUse": {
          "enum": [
            "PRECONDITION-ONLY",
            "VISIBLE-STIMULUS",
            "VISIBLE-OBJECT-EVENT"
          ]
        },
        "executedByScenario": {
          "type": "boolean"
        },
        "notWireOpcode": {
          "type": "boolean"
        },
        "stateFacts": {
          "$ref": "#/$defs/stateFacts"
        }
      }
    },
    "traceabilityRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "stateOrActionId",
        "sourceRelationIds",
        "visibleEvidence",
        "existingInterfaceIds",
        "interfaceUse",
        "acceptanceWitnessIds",
        "notCovered"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "stateOrActionId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceRelationIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "visibleEvidence": {
          "$ref": "#/$defs/nonBlank"
        },
        "existingInterfaceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "interfaceUse": {
          "$ref": "#/$defs/identifier"
        },
        "acceptanceWitnessIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notCovered": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "definition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "NORMAL",
            "SINGLE-FAULT"
          ]
        },
        "definition": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "hypothesisDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members",
        "activeFaultVisibility",
        "algorithmMayKnow",
        "algorithmMustNotReceive",
        "coverageLimit",
        "coverageLimitZh"
      ],
      "properties": {
        "members": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/hypothesis"
          }
        },
        "activeFaultVisibility": {
          "const": "EVALUATOR-ONLY"
        },
        "algorithmMayKnow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "algorithmMustNotReceive": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "coverageLimit": {
          "$ref": "#/$defs/nonBlank"
        },
        "coverageLimitZh": {
          "$ref": "#/$defs/nonBlank"
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition",
        "computation",
        "preparation",
        "retry"
      ],
      "properties": {
        "acquisition": {
          "type": "integer",
          "minimum": 0
        },
        "computation": {
          "type": "integer",
          "minimum": 0
        },
        "preparation": {
          "type": "integer",
          "minimum": 0
        },
        "retry": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completionReceipt",
        "journalPredicate",
        "finiteHorizonTicks",
        "isProtocolNoResponseVerdict",
        "fabricatedProtocolResponse"
      ],
      "properties": {
        "completionReceipt": {
          "$ref": "#/$defs/identifier"
        },
        "journalPredicate": {
          "$ref": "#/$defs/nonBlank"
        },
        "finiteHorizonTicks": {
          "type": "integer",
          "minimum": 1
        },
        "isProtocolNoResponseVerdict": {
          "const": false
        },
        "fabricatedProtocolResponse": {
          "const": false
        }
      }
    },
    "summaryDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicSources",
        "forbiddenPrivateSources"
      ],
      "properties": {
        "publicSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "forbiddenPrivateSources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "possibleOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observable",
        "postSummary",
        "summaryConfirmedWhen",
        "summaryConfirmedWhenZh",
        "compatibleHypotheses"
      ],
      "properties": {
        "observable": {
          "$ref": "#/$defs/identifier"
        },
        "postSummary": {
          "$ref": "#/$defs/identifier"
        },
        "summaryConfirmedWhen": {
          "$ref": "#/$defs/nonBlank"
        },
        "summaryConfirmedWhenZh": {
          "$ref": "#/$defs/nonBlank"
        },
        "compatibleHypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "eligibility",
        "cost",
        "publicStimulus",
        "observationMode",
        "successorConfirmation",
        "unconfirmedEffectDisposition",
        "historyDisposition",
        "inspection",
        "summaryDerivation",
        "possibleOutcomes",
        "nonEvaluatedObligations",
        "zh"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "TEST",
            "PREP",
            "RECOVER"
          ]
        },
        "eligibility": {
          "$ref": "#/$defs/nonBlank"
        },
        "cost": {
          "$ref": "#/$defs/cost"
        },
        "publicStimulus": {
          "$ref": "#/$defs/nonBlank"
        },
