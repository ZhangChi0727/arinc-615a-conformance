@startuml FIG-CL-TAV-05
skinparam shadowing false
title FIG-CL-TAV-05 Closed-loop activity\nSysML 1.6 notation-based views; executable/metamodel conformance is not claimed\nadmissible set first; selected mode XOR; charge once; ERROR history

start
:Idle; declare selected mode BUDGET(cmin,B) XOR ROUNDS(Kmax);
repeat
  :Build admissible A(qk) = TEST, Prep, Recover meeting preconditions AND selected-mode resource;
  if (A empty?) then (yes)
    :Classify empty: Stop-Budget / Stop-NoDistinguisher / Stop-Error;
    stop
  else (never argmin empty A)
    :Select from A by one-step minimax on tests, else Prep, else Recover;
    :Execute chosen action toward Mprot through FIG-CL-TAV-04 ports;
    :Charge cost once under the selected mode;
    if (instrument / correlation / record valid?) then (yes)
      :Observe Izk; Update Hk; qk known;
      if (Hk empty?) then (yes)
        :Stop-Empty;
        stop
      elseif (|Hk| == 1) then (yes)
        :Stop-Singleton;
        stop
      elseif (named 645-blocked item?) then (yes)
        :Stop-645;
        stop
      elseif (observational equivalence established?) then (yes)
        :Stop-Equivalent;
        stop
      elseif (selected-mode resource exhausted?) then (yes)
        :Stop-Budget;
        stop
      else (continue to next Admit)
        :qk+1 known;
      endif
    else (ERROR)
      :ErrorHandle; do not exclude Hk candidates;
      if (confirmed not sent?) then (yes)
        :qk status unchanged; record ERROR history;
        if (retry cap reached?) then (yes)
          :Stop-Error;
          stop
        endif
      else (unknown-effect)
        :qk unknown; record failed history; do not reuse T(q_old);
        if (Recover not admissible or retry cap reached?) then (yes)
          :Stop-Error;
          stop
        endif
      endif
    endif
  endif
repeat while (session open?) is (yes)
stop
@enduml
